{
  "name": "@claudiavas/consent-banner",
  "version": "0.1.0",
  "description": "A GDPR cookie consent banner for React with Google Consent Mode v2, i18n, light/dark themes and a consent log hook.",
  "license": "MIT",
  "author": "Claudia Vasquez",
  "repository": "github:claudiavas/consent-banner",
  "homepage": "https://github.com/claudiavas/consent-banner#readme",
  "bugs": "https://github.com/claudiavas/consent-banner/issues",
  "keywords": [
    "react",
    "nextjs",
    "gdpr",
    "cookie",
    "consent",
    "cookie-banner",
    "consent-mode",
    "gtag",
    "google-tag-manager",
    "cookie-consent",
    "consent-management",
    "cmp",
    "eprivacy",
    "lgpd",
    "i18n",
    "dark-mode",
    "typescript",
    "cookieyes-alternative"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./consent-mode": {
      "import": {
        "types": "./dist/consent-mode.d.ts",
        "default": "./dist/consent-mode.js"
      },
      "require": {
        "types": "./dist/consent-mode.d.cts",
        "default": "./dist/consent-mode.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
